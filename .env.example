# Database
DATABASE_URL="file:./starconnect.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here-change-in-production"

# Google OAuth (get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth (optional)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Anthropic API (for AI booking agent)
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Admin Email (receives all booking notifications)
ADMIN_EMAIL="management.team@mail.com"

# Email (SMTP for sending notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="StarConnect Pro <noreply@starconnect.pro>"

# Stripe (for payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="StarConnect Pro"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
