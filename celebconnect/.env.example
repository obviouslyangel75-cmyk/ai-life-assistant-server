# Server
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_JWT_SECRET=change-this-to-a-different-long-random-string

# Seed admin account (created on first `npm run seed`)
ADMIN_EMAIL=admin@celebconnect.local
ADMIN_PASSWORD=change-me-now

# Stripe (optional). Leave blank to run in mock-payment mode, where
# subscriptions are recorded immediately without contacting Stripe.
# Fill these in and restart the server to switch to real Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_VIP=
CLIENT_URL=http://localhost:4000
